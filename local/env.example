# AI-Q Local Environment Configuration
# =====================================
#
# Copy this file to .env.local and customize for your setup.
# Usage: source .env.local && python -m uvicorn backend.main:app --reload
#

# ========================================
# Ollama Configuration
# ========================================

# Ollama API endpoint (OpenAI-compatible)
LLM_BASE_URL=http://localhost:11434/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1

# LLM model - choose based on your GPU VRAM
# See presets below for recommendations
LLM_MODEL=llama3.1:8b-instruct-q8_0

# Embedding model
EMBEDDING_MODEL=nomic-embed-text

# ========================================
# Model Presets (uncomment one)
# ========================================

# Workstation GPU (A6000 - 48GB VRAM):
# LLM_MODEL=llama3.1:70b-instruct-q4_K_M
# EMBEDDING_MODEL=nomic-embed-text

# Workstation GPU (A5000/RTX 4090 - 24GB VRAM):
# LLM_MODEL=llama3.1:8b-instruct-q8_0
# EMBEDDING_MODEL=nomic-embed-text

# Workstation GPU (A4000 - 16GB VRAM):
# LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# EMBEDDING_MODEL=mxbai-embed-large

# Consumer GPU (RTX 4070/3070 - 8-12GB VRAM):
# LLM_MODEL=llama3.2:3b-instruct-q8_0
# EMBEDDING_MODEL=nomic-embed-text

# Consumer GPU (RTX 3060/4060 - 8GB VRAM):
# LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
# EMBEDDING_MODEL=all-minilm:l6-v2

# CPU-only (no GPU):
# LLM_MODEL=llama3.2:1b-instruct-q4_K_M
# EMBEDDING_MODEL=all-minilm:l6-v2

# ========================================
# Milvus Lite Configuration
# ========================================

# Enable Milvus Lite (in-process vector DB)
MILVUS_LITE=true

# Path to Milvus Lite database file
MILVUS_DATA_PATH=./data/milvus/milvus.db

# ========================================
# Local Mode Flag
# ========================================

# Enable local mode (disables cloud/Kubernetes defaults)
LOCAL_MODE=true

# ========================================
# Web Search (Optional)
# ========================================

# Tavily API Key for web search functionality
# Get your key at: https://tavily.com
# Leave empty to disable web search
TAVILY_API_KEY=

# ========================================
# Advanced Configuration
# ========================================

# LLM parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Embedding dimension (auto-detected from model, override if needed)
# EMBEDDING_DIMENSION=768

# Backend server settings
# HOST=0.0.0.0
# PORT=8000

# ========================================
# Alternative Backend Options
# ========================================

# If using vLLM instead of Ollama:
# INFERENCE_BACKEND=vllm
# LLM_BASE_URL=http://localhost:8000/v1

# If using SGLang:
# INFERENCE_BACKEND=sglang
# LLM_BASE_URL=http://localhost:30000/v1

# If using remote Milvus server instead of Lite:
# MILVUS_LITE=false
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# VECTOR_DB_BACKEND=milvus_standalone

